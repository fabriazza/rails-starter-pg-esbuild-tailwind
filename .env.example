APP_HOST=localhost
APP_PROTOCOL=http
PORT=3000
RAILS_MAX_THREADS=3

# Production database
POSTGRES_HOST=localhost
POSTGRES_USER=rails_starter
POSTGRES_PASSWORD=

# Production mail delivery
SMTP_ADDRESS=localhost
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true

# Single-server production deployments can run Solid Queue inside Puma.
SOLID_QUEUE_IN_PUMA=false
JOB_CONCURRENCY=1
